# Database backend: "sqlite", "postgres", or "supabase"
DB_TYPE=supabase

# Used when DB_TYPE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon_or_publishable_key>
SUPABASE_PUBLISHABLE_KEY=<publishable_key>

# Used when DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=privacyguard
POSTGRES_USER=privacyguard
POSTGRES_PASSWORD=

# Used when DB_TYPE=sqlite
DB_PATH=./privacyguard.db

# ML model + tracker data locations
MODEL_PATH=./models/
TRACKER_DATA_PATH=./trackers/

LOG_LEVEL=INFO
LOG_PATH=./privacyguard.log

API_HOST=127.0.0.1
API_PORT=8000
