# Database: "sqlite" (default, zero-config) or "postgres"
DB_TYPE=sqlite
DB_PATH=./privacyguard.db

# Only used when DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=privacyguard
POSTGRES_USER=privacyguard
POSTGRES_PASSWORD=

# ML model + tracker data locations
MODEL_PATH=./models/
TRACKER_DATA_PATH=./trackers/

LOG_LEVEL=INFO
LOG_PATH=./privacyguard.log

API_HOST=127.0.0.1
API_PORT=8000
